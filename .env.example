# Slack Bot Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_APP_TOKEN=xapp-your-app-token-here

# Slack Admin Alerts (optional)
# Where the bot sends critical alerts (e.g. token refresh timeouts).
# Use your member ID (U...) for a DM, or a channel ID (C...) for a channel.
# Only needed by the running bot (set in Railway Variables), NOT by
# scripts/get_fortnox_token.py.
SLACK_ADMIN_CHANNEL_ID=your-member-or-channel-id-here

# Fortnox API Configuration (Service Account)
# See FORTNOX_SERVICE_ACCOUNT_SETUP.md for detailed setup instructions
# Or use the automated script: python get_fortnox_token.py

# Required: Get these from https://developer.fortnox.se/
# These two are required by scripts/get_fortnox_token.py - it needs them
# in your LOCAL .env to run the OAuth flow and obtain the tokens below.
FORTNOX_CLIENT_ID=your-client-id-here
FORTNOX_CLIENT_SECRET=your-client-secret-here

# Auto-generated by get_fortnox_token.py (or add manually)
FORTNOX_ACCESS_TOKEN=your-access-token-here
FORTNOX_REFRESH_TOKEN=your-refresh-token-here

# Token override (optional, for recovery only)
# Set to "true" to force the bot to overwrite any stored tokens (DB + file) with the
# env var values above on next startup. Use this if the stored token is stale/invalid
# and the bot won't start. Remove or set to "false" after the bot has started successfully.
# FORCE_TOKEN_FROM_ENV=true

# Server Configuration
PORT=3000
